# SKAD GROUP Environment Configuration
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=skad-secret-key-change-in-production-2026-secure-hash-token
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- PostgreSQL Database Credentials ---
# Option A: Connection URL format:
# DATABASE_URL=postgres://your_user:your_password@localhost:5432/skad_db
#
# Option B: Individual variables format:
# DB_NAME=skad_corporate_db
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS / Frontend origin
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=True

# Security & Revalidation
REVALIDATE_SECRET=skad-revalidation-shared-secret-key-2026
PRIVACY_POLICY_VERSION=2026.1

# Turnstile / Captcha
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=False

# Email / SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SKAD GROUP <no-reply@skadgroup.com>

# S3 / MinIO Object Storage (Dual-Bucket Architecture per Pages 3, 8, 13, 19, 20)
USE_S3=False
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin2026
AWS_STORAGE_BUCKET_NAME=skad-public-media
AWS_PRIVATE_STORAGE_BUCKET_NAME=skad-private-uploads
AWS_S3_REGION_NAME=us-east-1
# For local Docker development with MinIO:
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# For production CDN (CloudFront / Cloudflare):
# AWS_S3_CUSTOM_DOMAIN=cdn.skadgroup.com
